{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "downlevelIteration": true,
    "moduleResolution": "bundler",
    "types": ["react", "react-native"],
    "skipLibCheck": true
  }
}
